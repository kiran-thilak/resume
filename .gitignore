# Dependencies
node_modules/

# Build output (regenerate with `npm run pdf`) — the PDF itself is committed
# so hosts without a Chrome/Edge binary (e.g. Hostinger) can serve it as-is.
dist/*
!dist/kiran_thilak_resume.pdf

# Build output (regenerate with `npm run css:build`) — committed because
# Hostinger's Passenger layer serves public/assets/* directly from disk,
# bypassing the app (and its build step) entirely when a file is missing.

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables
.env
.env.local
.env.*.local

# OS files
.DS_Store
Thumbs.db

# Editor directories
.vscode/
.idea/
